---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Orca — Container + Wasm Orchestrator</title>
  <meta name="description" content="Fills the gap between Coolify and Kubernetes. Single binary, multi-node, AI ops." />
  <link rel="icon" href={`${base}/logo.svg`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <canvas id="ocean-canvas"></canvas>

  <!-- Topbar -->
  <header class="topbar">
    <a class="logo" href={`${base}/`}>
      <img class="logo-icon" src={`${base}/logo.svg`} alt="Orca" />
      <span class="logo-wordmark">orca<span class="logo-accent">.</span>dev</span>
    </a>
    <ul class="topbar-nav">
      <li><a href={`${base}/guide/getting-started`}>Guide</a></li>
      <li><a href={`${base}/comparison`}>Compare</a></li>
      <li><a href={`${base}/reference/api`}>API</a></li>
      <li><a href="https://github.com/mighty840/orca" target="_blank" rel="noopener">GitHub ↗</a></li>
    </ul>
    <a class="btn-version" href="https://github.com/mighty840/orca/releases" target="_blank" rel="noopener">v0.2.4</a>
  </header>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-eyebrow">
      <span class="eyebrow-dot"></span>
      Container + Wasm Orchestrator
    </div>
    <h1 class="hero-title">
      The layer<br/>
      <em>between Coolify<br/>and Kubernetes</em>
    </h1>
    <p class="hero-desc">
      One 47 MB binary. Raft consensus. AI ops. GPU scheduling. WebAssembly.
      Self-healing. Auto-TLS. Multi-node clusters up to 20 nodes.
      Zero external dependencies.
    </p>
    <div class="hero-actions">
      <a class="btn-primary" href={`${base}/guide/getting-started`}>Get Started</a>
      <a class="btn-ghost" href={`${base}/comparison`}>Why Orca?</a>
    </div>

    <!-- Position strip -->
    <div class="position-strip">
      <span class="pos-item dim">Docker Compose<br/><small>1 node</small></span>
      <span class="pos-arrow"></span>
      <span class="pos-item dim">Coolify / Dokploy<br/><small>1 node, GUI</small></span>
      <span class="pos-arrow"></span>
      <span class="pos-item highlight">Orca<br/><small>2–20 nodes</small></span>
      <span class="pos-arrow"></span>
      <span class="pos-item dim">Kubernetes<br/><small>20–10k nodes</small></span>
    </div>
  </section>

  <!-- Install -->
  <section class="install-section">
    <div class="install-label">Quick Install</div>
    <div class="install-box">
      <span class="install-prompt">$</span>
      <code class="install-cmd">cargo install mallorca && sudo setcap 'cap_net_bind_service=+ep' $(which orca)</code>
      <button class="copy-btn" id="copy-btn">copy</button>
    </div>
  </section>

  <!-- Features -->
  <section class="features">
    <div class="feature-card">
      <div class="feat-icon">📦</div>
      <div class="feat-title">Single Binary</div>
      <p class="feat-desc">Agent, control plane, CLI, and proxy in one 47 MB executable. scp it to any Linux server and run.</p>
    </div>
    <div class="feature-card">
      <div class="feat-icon">🌐</div>
      <div class="feat-title">Multi-Node</div>
      <p class="feat-desc">Raft consensus via openraft. Embedded redb storage. No etcd. <code>orca join</code> and you're in the cluster.</p>
    </div>
    <div class="feature-card">
      <div class="feat-icon">🤖</div>
      <div class="feat-title">AI Ops</div>
      <p class="feat-desc"><code>orca ask "why is the API slow?"</code> — diagnose issues in plain English. Works with any OpenAI-compatible LLM.</p>
    </div>
    <div class="feature-card">
      <div class="feat-icon">🔒</div>
      <div class="feat-title">Auto-TLS</div>
      <p class="feat-desc">ACME/Let's Encrypt built in. Certificates provisioned and renewed automatically for every domain.</p>
    </div>
    <div class="feature-card">
      <div class="feat-icon">⚡</div>
      <div class="feat-title">WebAssembly</div>
      <p class="feat-desc">Run Wasm modules via wasmtime alongside containers. Cold start in ~5 ms, ~2 MB per instance, hundreds on one node.</p>
    </div>
    <div class="feature-card">
      <div class="feat-icon">🎮</div>
      <div class="feat-title">GPU Scheduling</div>
      <p class="feat-desc">Declare NVIDIA or AMD GPU requirements. The scheduler filters nodes by VRAM availability automatically.</p>
    </div>
    <div class="feature-card">
      <div class="feat-icon">🔄</div>
      <div class="feat-title">Self-Healing</div>
      <p class="feat-desc">Watchdog restarts crashed containers in ~30s. Agents reconnect automatically after network partitions.</p>
    </div>
    <div class="feature-card">
      <div class="feat-icon">📁</div>
      <div class="feat-title">Config as Code</div>
      <p class="feat-desc">Every service fits in ~10 lines of TOML. Put it in git. Push to deploy via the infra webhook.</p>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <span>Released under the AGPL-3.0 License</span>
    <span class="footer-sep">·</span>
    <a href={`${base}/legal/privacy-policy`}>Privacy Policy</a>
    <span class="footer-sep">·</span>
    <a href={`${base}/legal/impressum`}>Impressum</a>
    <span class="footer-sep">·</span>
    <span>Copyright 2025-present Orca Contributors</span>
  </footer>
</body>
</html>

<style>
  :root {
    --ocean-void: #020b14;
    --ocean-mid: #091929;
    --ocean-surface: #0d2237;
    --biolum: #00e5c8;
    --biolum-glow: #00ffde;
    --biolum-dim: #007a6c;
    --foam: rgba(0,229,200,0.07);
    --text-bright: #e8f4f8;
    --text-mid: #7fb8cc;
    --text-dim: #3a6a80;
    --border: rgba(0,229,200,0.1);
  }

  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    font-family: 'Bricolage Grotesque', sans-serif;
    background: var(--ocean-void);
    color: var(--text-bright);
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
  }

  body::before {
    content: '';
    position: fixed; inset: 0;
    background:
      radial-gradient(ellipse 80% 50% at 20% 60%, rgba(0,102,255,0.06) 0%, transparent 60%),
      radial-gradient(ellipse 60% 80% at 80% 20%, rgba(0,229,200,0.04) 0%, transparent 60%);
    pointer-events: none; z-index: 0;
  }

  #ocean-canvas {
    position: fixed; inset: 0; width: 100%; height: 100%;
    pointer-events: none; z-index: 0; opacity: 0.55;
  }

  .topbar {
    display: flex; align-items: center; gap: 1.5rem;
    padding: 0 2rem; height: 64px;
    border-bottom: 1px solid var(--border);
    background: rgba(2,11,20,0.9); backdrop-filter: blur(20px);
    position: sticky; top: 0; z-index: 100;
    position: relative; z-index: 1;
  }

  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .logo-icon { width: 30px; height: 30px; }
  .logo-wordmark { font-size: 1.2rem; font-weight: 700; letter-spacing: -0.02em; color: var(--text-bright); }
  .logo-accent { color: var(--biolum); }

  .topbar-nav { display: flex; list-style: none; margin-left: 1rem; }
  .topbar-nav a { display: block; padding: 0.35rem 0.85rem; color: var(--text-mid); text-decoration: none; font-size: 0.85rem; font-weight: 500; border-radius: 6px; transition: all 0.15s; }
  .topbar-nav a:hover { color: var(--biolum); background: var(--foam); }

  .btn-version {
    margin-left: auto; padding: 0.35rem 0.85rem;
    border: 1px solid var(--biolum); background: rgba(0,229,200,0.08);
    color: var(--biolum-glow); font-size: 0.78rem; font-weight: 600;
    border-radius: 6px; text-decoration: none;
    box-shadow: 0 0 10px rgba(0,229,200,0.12);
    font-family: 'JetBrains Mono', monospace; transition: all 0.15s;
  }
  .btn-version:hover { background: rgba(0,229,200,0.14); }

  /* ── HERO ── */
  .hero {
    position: relative; z-index: 1;
    max-width: 860px; margin: 0 auto;
    padding: 6rem 2rem 4rem;
    text-align: center;
  }

  .hero-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 0.78rem; font-weight: 600; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--biolum);
    border: 1px solid rgba(0,229,200,0.25); background: rgba(0,229,200,0.06);
    padding: 5px 14px; border-radius: 20px; margin-bottom: 2rem;
  }

  .eyebrow-dot {
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--biolum); box-shadow: 0 0 6px var(--biolum);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
  }

  h1.hero-title {
    font-size: clamp(2.8rem, 6vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--text-bright);
    margin-bottom: 1.5rem;
  }

  h1.hero-title em {
    font-style: normal;
    background: linear-gradient(135deg, var(--biolum-glow), #0066ff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-desc {
    font-size: 1.05rem; color: var(--text-mid); line-height: 1.7;
    max-width: 580px; margin: 0 auto 2.5rem; font-weight: 300;
  }

  .hero-actions { display: flex; gap: 12px; justify-content: center; margin-bottom: 4rem; }

  .btn-primary {
    padding: 0.75rem 2rem; border-radius: 8px; font-size: 0.95rem; font-weight: 700;
    background: var(--biolum); color: #001a14; border: none; cursor: pointer;
    text-decoration: none; font-family: inherit; transition: all 0.15s;
    box-shadow: 0 0 24px rgba(0,229,200,0.3);
  }
  .btn-primary:hover { background: var(--biolum-glow); box-shadow: 0 0 36px rgba(0,229,200,0.4); }

  .btn-ghost {
    padding: 0.75rem 1.75rem; border-radius: 8px; font-size: 0.95rem; font-weight: 600;
    background: transparent; color: var(--text-mid); border: 1px solid var(--border);
    cursor: pointer; text-decoration: none; font-family: inherit; transition: all 0.15s;
  }
  .btn-ghost:hover { border-color: var(--biolum-dim); color: var(--biolum); }

  /* Position strip */
  .position-strip {
    display: flex; align-items: center; justify-content: center; gap: 1rem;
    font-family: 'JetBrains Mono', monospace; font-size: 0.8rem;
    background: var(--ocean-mid); border: 1px solid var(--border);
    border-radius: 10px; padding: 1.25rem 2rem; flex-wrap: wrap;
  }

  .pos-item { text-align: center; line-height: 1.5; }
  .pos-item small { display: block; font-size: 0.7em; opacity: 0.6; }
  .pos-item.dim { color: var(--text-dim); }
  .pos-item.highlight { color: var(--biolum-glow); font-weight: 700; }
  .pos-arrow {
    display: flex;
    align-items: center;
    width: 40px;
    height: 1px;
    background: var(--text-dim);
    position: relative;
    opacity: 0.4;
    flex-shrink: 0;
  }
  .pos-arrow::after {
    content: '';
    position: absolute;
    right: -1px;
    top: -3px;
    border: 4px solid transparent;
    border-left-color: var(--text-dim);
    border-right: none;
  }

  /* ── INSTALL ── */
  .install-section {
    position: relative; z-index: 1;
    max-width: 820px; margin: 0 auto; padding: 0 2rem 3rem;
  }

  .install-label {
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--text-dim);
    font-family: 'JetBrains Mono', monospace; margin-bottom: 0.5rem;
  }

  .install-box {
    display: flex; align-items: center; gap: 10px;
    background: #020c18; border: 1px solid var(--border);
    border-left: 3px solid var(--biolum); border-radius: 10px;
    padding: 1rem 1.25rem;
    box-shadow: 0 0 20px rgba(0,229,200,0.06);
  }

  .install-prompt { color: var(--biolum-dim); font-family: 'JetBrains Mono', monospace; }

  .install-cmd {
    font-family: 'JetBrains Mono', monospace; font-size: 0.875rem;
    color: var(--biolum-glow); flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  .copy-btn {
    padding: 4px 12px; border: 1px solid var(--border); background: var(--ocean-mid);
    color: var(--text-dim); border-radius: 5px; font-size: 0.75rem;
    cursor: pointer; font-family: 'JetBrains Mono', monospace; transition: all 0.15s; flex-shrink: 0;
  }
  .copy-btn:hover { border-color: var(--biolum-dim); color: var(--biolum); }

  /* ── FEATURES ── */
  .features {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 12px; max-width: 1100px; margin: 0 auto; padding: 0 2rem 5rem;
  }

  .feature-card {
    background: var(--ocean-mid); border: 1px solid var(--border);
    border-radius: 12px; padding: 1.25rem 1.4rem; transition: all 0.2s;
    position: relative; overflow: hidden;
  }

  .feature-card::after {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(circle at 50% 0%, rgba(0,229,200,0.05) 0%, transparent 70%);
    opacity: 0; transition: opacity 0.3s;
  }

  .feature-card:hover { border-color: var(--biolum-dim); transform: translateY(-2px); }
  .feature-card:hover::after { opacity: 1; }

  .feat-icon { font-size: 1.4rem; margin-bottom: 0.6rem; }
  .feat-title { font-size: 0.95rem; font-weight: 700; color: var(--text-bright); margin-bottom: 0.4rem; }
  .feat-desc { font-size: 0.82rem; color: var(--text-dim); line-height: 1.6; font-weight: 300; }
  .feat-desc code { font-family: 'JetBrains Mono', monospace; font-size: 0.85em; color: var(--biolum); }

  /* ── FOOTER ── */
  .footer {
    position: relative; z-index: 1;
    display: flex; align-items: center; justify-content: center; flex-wrap: wrap;
    gap: 0.5rem; padding: 2rem; border-top: 1px solid var(--border);
    font-size: 0.78rem; color: var(--text-dim);
  }
  .footer a { color: var(--text-dim); text-decoration: none; transition: color 0.12s; }
  .footer a:hover { color: var(--biolum); }
  .footer-sep { opacity: 0.4; }
</style>

<script>
  // Particle system
  const canvas = document.getElementById('ocean-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  function resize() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
  resize();
  window.addEventListener('resize', resize);

  const particles = Array.from({ length: 90 }, () => ({
    x: Math.random() * window.innerWidth,
    y: Math.random() * window.innerHeight,
    r: Math.random() * 2 + 0.5,
    vx: (Math.random() - 0.5) * 0.12,
    vy: (Math.random() - 0.5) * 0.06 - 0.04,
    opacity: Math.random() * 0.55 + 0.08,
    pulse: Math.random() * Math.PI * 2,
    pulseSpeed: 0.008 + Math.random() * 0.018,
  }));

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    const t = Date.now() * 0.001;
    for (const p of particles) {
      p.pulse += p.pulseSpeed;
      p.x += p.vx + Math.sin(t * 0.25 + p.y * 0.008) * 0.08;
      p.y += p.vy;
      if (p.y < -10) p.y = canvas.height + 10;
      if (p.x < -10) p.x = canvas.width + 10;
      if (p.x > canvas.width + 10) p.x = -10;
      const alpha = p.opacity * (0.4 + 0.6 * Math.sin(p.pulse));
      const grd = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r * 5);
      grd.addColorStop(0, `rgba(0,229,200,${alpha})`);
      grd.addColorStop(1, 'rgba(0,229,200,0)');
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r * 5, 0, Math.PI * 2);
      ctx.fillStyle = grd;
      ctx.fill();
    }
    requestAnimationFrame(draw);
  }
  draw();

  // Copy button
  document.getElementById('copy-btn')?.addEventListener('click', () => {
    const cmd = document.querySelector<HTMLElement>('.install-cmd')?.textContent || '';
    navigator.clipboard.writeText(cmd).then(() => {
      const btn = document.getElementById('copy-btn')!;
      btn.textContent = 'copied!';
      btn.style.color = '#00e5c8';
      setTimeout(() => { btn.textContent = 'copy'; btn.style.color = ''; }, 2000);
    });
  });
</script>
